{
  "schema_version": 1,
  "case_name": "stream_dut",
  "clock_reset": {
    "clock_source": "cocotb.clock.Clock(dut.clk, 10, units='ns').start()",
    "reset_active_level": 0,
    "reset_assert_cycles": 5,
    "reset_deassert_after_cycles": 2
  },
  "drivers": [
    {
      "name": "stream_driver",
      "interface": "stream",
      "handles_ports": [
        "clk",
        "rst_n",
        "in_valid",
        "in_ready",
        "in_data",
        "out_valid",
        "out_ready",
        "out_data"
      ],
      "handshake": "valid_ready",
      "backpressure_strategy": "random_out_ready"
    }
  ],
  "monitors": [
    {
      "name": "stream_monitor",
      "interface": "stream",
      "sampling_edge": "posedge clk",
      "samples": [
        {
          "port": "in_ready",
          "condition": "handshake"
        },
        {
          "port": "out_valid",
          "condition": "handshake"
        },
        {
          "port": "out_data",
          "condition": "handshake"
        }
      ]
    }
  ],
  "scoreboard": {
    "name": "StreamScoreboard",
    "type": "transaction_level",
    "checks": [
      "fifo_order",
      "data_integrity"
    ]
  },
  "dut_wiring": {
    "top": "stream_dut",
    "wrapper_module": "tb_top",
    "files": [
      "D:\\111\\tb_enviroment\\sample_out\\case1\\generated_tb\\dut_inst.v",
      "D:\\111\\tb_enviroment\\public_dataset\\case1\\rtl\\stream_dut.v"
    ]
  },
  "testbench_source": "generated_tb/tb_top.py"
}